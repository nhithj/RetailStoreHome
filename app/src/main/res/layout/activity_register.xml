<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/page_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tạo tài khoản" android:textColor="@color/text_primary" android:textSize="26sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Đăng ký tài khoản khách hàng để mua và theo dõi đơn" android:textColor="@color/text_secondary" android:textSize="15sp"/>
        <EditText android:id="@+id/edtRegisterName" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp" android:hint="Họ và tên" android:inputType="textPersonName"/>
        <EditText android:id="@+id/edtRegisterUser" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:hint="Tên đăng nhập" android:inputType="text"/>
        <EditText android:id="@+id/edtRegisterPhone" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:hint="Số điện thoại" android:inputType="phone"/>
        <EditText android:id="@+id/edtRegisterPassword" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:hint="Mật khẩu (ít nhất 6 ký tự)" android:inputType="textPassword"/>
        <EditText android:id="@+id/edtRegisterConfirm" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:hint="Nhập lại mật khẩu" android:inputType="textPassword"/>
        <Button android:id="@+id/btnRegister" style="@style/Widget.RetailStore.Button.Primary" android:layout_marginTop="20dp" android:text="Đăng ký"/>
    </LinearLayout>
</ScrollView>
