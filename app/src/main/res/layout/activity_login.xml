<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/page_background" android:orientation="vertical" android:padding="24dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đăng nhập" android:textColor="@color/text_primary" android:textSize="26sp" android:textStyle="bold"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Người bán: admin / 123&#10;Khách hàng: khachhang / 123" android:textColor="@color/text_secondary"/>
    <EditText android:id="@+id/edtUser" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:hint="Tên đăng nhập"/>
    <EditText android:id="@+id/edtPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Mật khẩu" android:inputType="textPassword"/>
    <Button android:id="@+id/btnLoginNow" style="@style/Widget.RetailStore.Button.Primary" android:layout_marginTop="24dp" android:text="Đăng nhập"/>
</LinearLayout>
