<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/page_background">
<ScrollView android:id="@+id/homeScroll"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <LinearLayout android:id="@+id/customerArea" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical">
                <ImageView android:layout_width="52dp" android:layout_height="52dp"
                    android:src="@drawable/ic_store" android:contentDescription="@string/store_logo_description" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:layout_weight="1" android:text="@string/store_name"
                    android:textColor="@color/primary" android:textSize="17sp" android:textStyle="bold" />
                <Button android:id="@+id/btnLogin" style="@style/Widget.RetailStore.Button.Outline"
                    android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginTop="0dp"
                    android:minHeight="0dp" android:text="Đăng nhập" android:textSize="12sp" />
            </LinearLayout>
            <EditText android:id="@+id/edtSearch" android:layout_width="match_parent" android:layout_height="54dp"
                android:layout_marginTop="16dp" android:background="@drawable/bg_info_card" android:hint="Tìm kiếm thiết bị y tế"
                android:paddingStart="16dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" />
            <Button android:id="@+id/btnSearch" style="@style/Widget.RetailStore.Button.Primary" android:layout_marginTop="8dp" android:text="Tìm kiếm" />
            <ImageView android:layout_width="match_parent" android:layout_height="170dp" android:layout_marginTop="16dp"
                android:background="@drawable/bg_product_card" android:contentDescription="Banner thiết bị y tế"
                android:scaleType="centerCrop" android:src="@drawable/banner_medical_store_v2" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp"
                android:text="Danh mục nổi bật" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
                <TextView android:id="@+id/categoryFamily" android:layout_width="0dp" android:layout_height="70dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/bg_product_card" android:gravity="center" android:text="Y tế&#10;gia đình" android:textAlignment="center" android:textColor="@color/text_primary" />
                <TextView android:id="@+id/categoryPro" android:layout_width="0dp" android:layout_height="70dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/bg_product_card" android:gravity="center" android:text="Y tế&#10;chuyên dụng" android:textAlignment="center" android:textColor="@color/text_primary" />
                <TextView android:id="@+id/categoryCare" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:background="@drawable/bg_product_card" android:gravity="center" android:text="Chăm sóc&#10;sức khỏe" android:textAlignment="center" android:textColor="@color/text_primary" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Sản phẩm gợi ý" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/homeProductGrid" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="vertical" />
            <View android:layout_width="match_parent" android:layout_height="88dp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/sellerArea" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <ImageView android:layout_width="58dp" android:layout_height="58dp" android:src="@drawable/ic_store" android:contentDescription="Logo cửa hàng" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="QUẢN TRỊ CỬA HÀNG" android:textColor="@color/primary" android:textSize="20sp" android:textStyle="bold" />
                <Button android:id="@+id/btnSellerLogout" style="@style/Widget.RetailStore.Button.Outline" android:layout_width="58dp" android:layout_height="46dp" android:layout_marginTop="0dp" android:contentDescription="Đăng xuất" android:drawableTop="@drawable/ic_logout" android:minWidth="0dp" android:padding="9dp" android:text="" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Tổng quan kho hàng" android:textColor="@color/text_primary" android:textSize="21sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_info_card" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Số lượng sản phẩm" android:textColor="@color/text_secondary" />
                <TextView android:id="@+id/tvProductCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/primary" android:textSize="24sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Tổng giá trị kho" android:textColor="@color/text_secondary" />
                <TextView android:id="@+id/tvTotalValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/primary" android:textSize="24sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal">
                <Button android:id="@+id/btnSellerAddProduct" style="@style/Widget.RetailStore.Button.Primary" android:layout_width="0dp" android:layout_height="94dp" android:layout_marginTop="0dp" android:layout_marginEnd="5dp" android:layout_weight="1" android:drawableTop="@drawable/ic_add" android:drawablePadding="5dp" android:text="Thêm sản phẩm" android:textSize="13sp" />
                <Button android:id="@+id/btnSellerProducts" style="@style/Widget.RetailStore.Button.Outline" android:layout_width="0dp" android:layout_height="94dp" android:layout_marginStart="5dp" android:layout_marginTop="0dp" android:layout_weight="1" android:drawableTop="@drawable/ic_products" android:drawablePadding="5dp" android:text="Quản lý kho" android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                <Button android:id="@+id/btnSellerOrders" style="@style/Widget.RetailStore.Button.Outline" android:layout_width="0dp" android:layout_height="94dp" android:layout_marginTop="0dp" android:layout_marginEnd="5dp" android:layout_weight="1" android:drawableTop="@drawable/ic_orders" android:drawablePadding="5dp" android:text="Đơn hàng" android:textSize="13sp" />
                <Button android:id="@+id/btnSellerDashboard" style="@style/Widget.RetailStore.Button.Outline" android:layout_width="0dp" android:layout_height="94dp" android:layout_marginStart="5dp" android:layout_marginTop="0dp" android:layout_weight="1" android:drawableTop="@drawable/ic_chart" android:drawablePadding="5dp" android:text="Doanh thu" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>

<!-- Thanh icon cố định bên dưới; được ẩn/hiện bằng thao tác vuốt. -->
<LinearLayout android:id="@+id/bottomActionBar" android:layout_width="match_parent" android:layout_height="86dp"
    android:layout_gravity="bottom" android:background="@color/white" android:elevation="8dp"
    android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="6dp" android:paddingEnd="6dp">
    <Button android:id="@+id/btnProductList" style="@style/Widget.RetailStore.Button.BottomNav" android:layout_marginEnd="3dp" android:drawableTop="@drawable/ic_products" android:text="Sản phẩm" />
    <Button android:id="@+id/btnCartHome" style="@style/Widget.RetailStore.Button.BottomNav" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:drawableTop="@drawable/ic_cart_action" android:text="Giỏ hàng" />
    <Button android:id="@+id/btnOrderHistory" style="@style/Widget.RetailStore.Button.BottomNav" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:drawableTop="@drawable/ic_orders" android:text="Đơn hàng" />
    <Button android:id="@+id/btnCustomerAddress" style="@style/Widget.RetailStore.Button.BottomNav" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:drawableTop="@drawable/ic_location" android:text="Địa chỉ" android:visibility="gone" />
    <Button android:id="@+id/btnSupport" style="@style/Widget.RetailStore.Button.BottomNav" android:layout_marginStart="3dp" android:drawableTop="@drawable/ic_support" android:text="Hỗ trợ" />
</LinearLayout>
</FrameLayout>
